# Opcional. URL pública canónica para SEO, sitemap y Open Graph (en Vercel se detecta automáticamente si no se define).
NEXT_PUBLIC_SITE_URL=

# Opcional. Sin claves se usa DuckDuckGo público con respaldo de Bing RSS.
# Si tienes Brave Search API, se consulta primero y conserva el respaldo público.
BRAVE_SEARCH_API_KEY=

# Necesaria únicamente para añadir la prueba móvil opcional de PageSpeed Insights.
PAGESPEED_API_KEY=
